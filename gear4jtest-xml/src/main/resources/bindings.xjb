<!DOCTYPE bindings>
<jaxb:bindings xmlns:xs="http://www.w3.org/2001/XMLSchema"
               xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
               version="3.0"
               xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
               jaxb:extensionBindingPrefixes="xjc">
    <jaxb:bindings schemaLocation="assembly-line.xsd" node=".//xs:complexType[@name='OperationsType']//xs:sequence">
        <jaxb:property name="operations"/>
    </jaxb:bindings>
</jaxb:bindings>
