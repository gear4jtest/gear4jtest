<?xml version="1.0" encoding="UTF-8"?>
<assemblyLine xmlns="http://github.com/gear4jtest/core/model"
              id="test_ifelse_v2"
              inputType="java.lang.String"
              outputType="java.lang.String">

  <operations>
    <ifElseContainer id="choice"
                     inputType="java.lang.String"
                     outputType="java.lang.String">
      <conditionalOperations>
        <conditionalOperation id="when-starts-with-a">
          <condition expression="input.startsWith(&quot;a&quot;)"/>
          <processingOperation id="append_true" type="com.myorg.operation.Step11">
            <parameters>
              <valueParameter retriever="com.myorg.operation.Step11::getParam" value="-true"/>
            </parameters>
          </processingOperation>
        </conditionalOperation>
      </conditionalOperations>
      <elseOperation id="append_false" type="com.myorg.operation.Step11">
        <parameters>
          <valueParameter retriever="com.myorg.operation.Step11::getParam" value="-false"/>
        </parameters>
      </elseOperation>
    </ifElseContainer>
  </operations>
</assemblyLine>
