<?xml version="1.0" encoding="UTF-8"?>
<assemblyLine xmlns="http://github.com/gear4jtest/core/model"
              id="test_ifelse"
              inputType="java.lang.String"
              outputType="java.lang.String">

    <operations>
        <processingOperation id="step11_init" type="Step11">
            <parameters>
                <valueParameter retriever="Step11::getParam" value="a"/>
            </parameters>
        </processingOperation>

        <ifElseContainer inputType="java.lang.String" outputType="java.lang.String">
            <conditionalOperations>
                <conditionalOperation>
                    <condition expression="(input, ctx) -> input.equals(&quot;a&quot;)"/>
                    <operation id="step11_c" type="Step11">
                        <parameters>
                            <valueParameter retriever="Step11::getParam" value="c"/>
                        </parameters>
                    </operation>
                </conditionalOperation>
                <conditionalOperation>
                    <condition expression="(input, ctx) -> input.equals(&quot;a&quot;)"/>
                    <operation id="step11_cd" type="Step11">
                        <parameters>
                            <valueParameter retriever="Step11::getParam" value="cd"/>
                        </parameters>
                    </operation>
                </conditionalOperation>
            </conditionalOperations>
            <elseOperation id="step11_else" type="Step11">
                <parameters>
                    <valueParameter retriever="Step11::getParam" value="b"/>
                </parameters>
            </elseOperation>
        </ifElseContainer>
    </operations>

    <configuration>
        <operationDefaultConfiguration/>
        <eventHandling>
            <eventBuses>
                <eventBus name="main">
                    <eventListeners>
                        <eventListener class="TestEventListener"/>
                    </eventListeners>
                </eventBus>
            </eventBuses>
            <globalEventConfiguration eventOnParameterChanged="true"/>
        </eventHandling>
    </configuration>
</assemblyLine>
