<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>

  <module name="SuppressionFilter">
    <property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
    <property name="optional" value="true"/>
  </module>

  <module name="NewlineAtEndOfFile"/>
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <module name="TreeWalker">
    <module name="RegexpSinglelineJava">
      <property name="id" value="NoSystemOut"/>
      <property name="format" value="System\.(out|err)\.print"/>
      <property name="message" value="Use a logger, assertions or test fixtures instead of System.out/System.err."/>
      <property name="ignoreComments" value="true"/>
    </module>

    <module name="RegexpSinglelineJava">
      <property name="id" value="NoPrintStackTrace"/>
      <property name="format" value="\.printStackTrace\("/>
      <property name="message" value="Do not call printStackTrace(); use logging or propagate the exception."/>
      <property name="ignoreComments" value="true"/>
    </module>
    <module name="OuterTypeFilename"/>
    <module name="OneTopLevelClass"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>

    <module name="IllegalImport">
      <property name="illegalClasses"
                value="org.junit.Test, org.junit.Assert, org.junit.Before, org.junit.After, org.junit.Rule, org.junit.runner.RunWith, org.junit.rules.ExpectedException"/>
    </module>

    <module name="IllegalImport">
      <property name="illegalPkgs" value="org.testng, org.hamcrest"/>
    </module>

    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <module name="StringLiteralEquality"/>
    <module name="ArrayTypeStyle"/>
    <module name="ModifierOrder"/>
    <module name="UpperEll"/>
  </module>
</module>
